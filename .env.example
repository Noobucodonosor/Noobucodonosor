# Porta del server locale / Cloud Run
PORT=8080
NODE_ENV=development

# Pool API a soglia gratuita (inserisci una o più chiavi gratuite; il router fa failover per profilo)
# Google AI Studio (progetto GCP SENZA billing collegato): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Groq (Free Tier - primario su compact-json): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (:free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mistral (Free Mode - ID datati, escludibile con EXCLUDE_MISTRAL=1): https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_LITE_MODEL=ministral-8b-2512
MISTRAL_MODEL=mistral-small-2603
EXCLUDE_MISTRAL=0

# Protezione quota gratuita & CORS (ADR-0004: allowlist esatta separata da virgole, mai * o null in prod)
IP_LIMIT_PER_HOUR=20
DAILY_FREE_CAP=500
ALLOWED_ORIGINS=https://noobucodonosor.github.io

# Difesa Livello 3: ALTCHA self-hosted Proof-of-Work (0=off in dev, 1=on in produzione)
ALTCHA_ENABLED=0
ALTCHA_HMAC_KEY=
ALTCHA_MAX_NUMBER=50000
ALTCHA_TTL_MS=300000

# Configurazione opzionale per deploy standalone di packages/ai-gateway
GATEWAY_SERVICE_NAME=noobucodonosor-hub
GATEWAY_BRAND=Noobucodonosor
GATEWAY_REFERER=https://noobucodonosor.github.io/
GATEWAY_TITLE=Noobucodonosor Hub
# GATEWAY_CONFIG_PATH=./showcase.config.json

# Approvazione live su smartphone (off | telegram | ntfy | auto)
APPROVAL_MODE=off
APPROVAL_TIMEOUT_MS=90000
APPROVAL_SECRET=
PUBLIC_BASE_URL=https://noobucodonosor-hub-664856461640.us-central1.run.app

# Telegram Bot (bottoni Approva / Nega)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ntfy.sh (alternativa zero-bot)
NTFY_TOPIC=
