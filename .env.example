# Porta del server locale / Cloud Run
PORT=8080

# Pool API a soglia gratuita (inserisci una o più chiavi gratuite; il router fa failover per profilo)
# Google AI Studio (progetto GCP SENZA billing collegato): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Groq (Free Tier - primario su compact-json): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (:free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mistral (Free Mode - ID datati, escludibile con EXCLUDE_MISTRAL=1): https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_LITE_MODEL=ministral-8b-2512
MISTRAL_MODEL=mistral-small-2603
EXCLUDE_MISTRAL=0

# Protezione quota gratuita & CORS
IP_LIMIT_PER_HOUR=20
DAILY_FREE_CAP=500
ALLOWED_ORIGIN=*

# Approvazione live su smartphone (off | telegram | ntfy | auto)
# Quando attiva, chiede conferma sul telefono per richieste non in cache prima di consumare API
APPROVAL_MODE=off
APPROVAL_TIMEOUT_MS=90000
APPROVAL_SECRET=
PUBLIC_BASE_URL=https://noobucodonosor-hub-664856461640.us-central1.run.app

# Telegram Bot (bottoni Approva / Nega)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ntfy.sh (alternativa zero-bot)
NTFY_TOPIC=
